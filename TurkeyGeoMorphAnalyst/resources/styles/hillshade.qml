        <colorrampshader colorRampType="DISCRETE" classificationMode="1" clip="0">
          <item alpha="255" value="51" label="Çok koyu gölge" color="#1a1a1a"/>
          <item alpha="255" value="102" label="Koyu gölge" color="#555555"/>
          <item alpha="255" value="153" label="Orta gölge" color="#999999"/>
          <item alpha="255" value="204" label="Açık gölge" color="#cccccc"/>
          <item alpha="255" value="255" label="Aydınlık" color="#ffffff"/>
        </colorrampshader>
      </rastershader>
    </rasterrenderer>
  </pipe>
</qgis>
